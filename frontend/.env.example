# ── Configuración del frontend (Create React App / CRACO) ──────────────
# Copia este archivo a .env y ajusta los valores para tu entorno local.
#
# URL BASE del backend (SIN la barra final y SIN /api; el código ya añade /api).
# En local, si el backend corre en el puerto 8001:
REACT_APP_BACKEND_URL=http://localhost:8001
#
# En producción apuntaría al dominio del backend, p.ej.:
# REACT_APP_BACKEND_URL=https://erp-crm-14-03-2026-production.up.railway.app
