# ── Configuración del backend (FastAPI) ────────────────────────────────
# Copia este archivo a .env y rellena los valores. NO subas el .env real.

# --- Base de datos (obligatorio) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=luiggi_home

# --- Seguridad (obligatorio en producción) ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Contraseña maestra de administración (opcional, para bootstrap):
MASTER_PASSWORD=

# --- CORS: orígenes permitidos separados por coma ---
CORS_ORIGINS=http://localhost:3000

# --- IA de visión (IA Lab, Digitalizador y Telemetría IA) ---
# Sin esta clave esos módulos devuelven 503 "Vision IA no configurada".
# Consíguela en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alternativa (plataforma Emergent), opcional:
EMERGENT_LLM_KEY=

# --- Email (facturas / notificaciones), opcional ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
RESEND_API_KEY=
ADMIN_EMAIL=
BACKUP_EMAIL=

# --- Integración con Google Calendar (opcional, por usuario) ---
# Crea credenciales OAuth 2.0 (tipo "Aplicación web") en
# https://console.cloud.google.com/apis/credentials y habilita la
# "Google Calendar API". En "URIs de redirección autorizados" añade EXACTAMENTE
# la misma URL que pongas en GOOGLE_OAUTH_REDIRECT_URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# URL pública del backend + /api/google-calendar/callback. Debe coincidir con
# la registrada en Google Cloud Console. Ej: https://erp.luiggihome.es/api/google-calendar/callback
GOOGLE_OAUTH_REDIRECT_URI=
# URL del frontend a la que volver tras conectar (si difiere del backend).
FRONTEND_URL=
# Zona horaria para los eventos que el ERP cree en Google (por defecto Europe/Madrid).
GOOGLE_CALENDAR_TIMEZONE=Europe/Madrid
